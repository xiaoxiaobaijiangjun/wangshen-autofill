{
  "manifest_version": 3,
  "name": "网申自动填写助手",
  "version": "1.3.6",
  "description": "简历字段库 + 短字段一键自动填 + 长文本点选填 + AI 开放题起草 + 投递台账。数据只存本机。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "网申自动填写助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://open.bigmodel.cn/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.openai.com/*",
    "https://api.siliconflow.cn/*",
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "data/templates.js",
        "content/detector.js",
        "content/filler.js",
        "content/floatbar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
